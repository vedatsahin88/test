#!/usr/bin/env python3
"""AWX icin YEREL webhook alici testi (yalnizca 127.0.0.1:8765).

Gercek AWX'e acik degildir, e-posta gondermez, API token kullanmaz.
Python 3.9 standart kutuphane ile calisir. Uretimde kullanilmaz.
"""
import json
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOST = "127.0.0.1"
PORT = 8765
MAX_BODY = 16 * 1024


class Handler(BaseHTTPRequestHandler):
    def _reply(self, code, obj):
        raw = json.dumps(obj).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.end_headers()
        self.wfile.write(raw)

    def do_GET(self):
        if self.path == "/health":
            self._reply(200, {"status": "ok", "mode": "local-test"})
        else:
            self._reply(404, {"error": "not found"})

    def do_POST(self):
        if self.path != "/awx/failure":
            self._reply(404, {"error": "not found"})
            return
        try:
            n = int(self.headers.get("Content-Length", "-1"))
        except ValueError:
            self._reply(400, {"error": "invalid length"})
            return
        if not 0 <= n <= MAX_BODY:
            self._reply(413, {"error": "payload too large or invalid"})
            return
        if "application/json" not in self.headers.get("Content-Type", "").lower():
            self._reply(415, {"error": "JSON required"})
            return
        try:
            payload = json.loads(self.rfile.read(n))
            if not isinstance(payload, dict):
                raise ValueError("object required")
        except (ValueError, UnicodeDecodeError):
            self._reply(400, {"error": "invalid JSON"})
            return

        # Guvenlik: Gelen JSON, hata ciktilari ve hassas basliklar loglanmaz.
        job_id = payload.get("id")
        status = payload.get("status")
        print("Webhook testi alindi. id tipi: {}, status tipi: {}".format(
            type(job_id).__name__, type(status).__name__), flush=True)
        self._reply(200, {"received": True, "mail_sent": False})


if __name__ == "__main__":
    server = ThreadingHTTPServer((HOST, PORT), Handler)
    print("Test alicisi basladi: http://{}:{}".format(HOST, PORT), flush=True)
    print("Durdurmek icin Ctrl+C. Sadece localhost; mail gondermez.", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nTest alicisi kapaniyor.")
    finally:
        server.server_close()
